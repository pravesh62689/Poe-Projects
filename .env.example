# Environment Configuration Template
# Copy this file to .env for local development. Never commit .env to version control!

# Poe Server Bot Authentication
POE_ACCESS_KEY=your_poe_access_key_here

# Cloudflare Configuration (for deployment & analytics)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# Render Configuration (for OCR service management)
RENDER_API_KEY=your_render_api_key_here

# Site Base URL
PUBLIC_SITE_URL=https://poe-developer-suite.pages.dev
